# Halt & Charge Backend — Railway + Supabase Environment Variables
# Set these as Railway Environment Variables (NOT committed to git)

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Go to: Supabase Dashboard → Project → Settings → Database → Connection string
#
# Option A — Direct connection (use for Spring Boot / JPA):
#   DB_URL=jdbc:postgresql://db.utmsomctnhgxmgagkgdl.supabase.co:5432/postgres?sslmode=require
#
# Option B — Pooler connection (use if you hit connection limits on free tier):
#   DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
DB_URL=jdbc:postgresql://db.utmsomctnhgxmgagkgdl.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password-here

# ─── Razorpay (BACKEND only — NEVER expose to frontend) ──────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# Webhook secret from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8080

# ─── CORS (set to your Railway frontend URL after deploying frontend) ─────────
FRONTEND_ORIGIN=https://halt-charge-payment.up.railway.app
