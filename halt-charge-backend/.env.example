# Halt & Charge Backend — Environment Variables
# Copy to .env and populate. NEVER commit real secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/haltcharge_payment
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ─── Razorpay (BACKEND — keep secret, never expose to frontend) ───────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# Webhook secret from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8080

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
