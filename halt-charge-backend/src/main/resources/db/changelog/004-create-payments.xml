<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-payments" author="haltcharge">
        <createTable tableName="payments">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_session_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payment_session"
                    references="payment_sessions(id)"/>
            </column>
            <column name="razorpay_order_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="razorpay_payment_id" type="VARCHAR(100)"/>
            <column name="razorpay_signature" type="VARCHAR(500)"/>
            <column name="amount_paise" type="BIGINT">
                <!-- Amount in smallest currency unit (paise for INR) -->
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="INR"/>
            <column name="status" type="VARCHAR(30)" defaultValue="CREATED">
                <!-- CREATED, CAPTURED, FAILED, REFUNDED -->
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(100)"/>
            <column name="gateway_response" type="TEXT"/>
            <column name="paid_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>
        <createIndex tableName="payments" indexName="idx_payments_rzp_order">
            <column name="razorpay_order_id"/>
        </createIndex>
        <createIndex tableName="payments" indexName="idx_payments_rzp_payment">
            <column name="razorpay_payment_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
