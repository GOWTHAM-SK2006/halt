<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-charging-sessions" author="haltcharge">
        <createTable tableName="charging_sessions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="station_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_session_station"
                    references="charging_stations(id)"/>
            </column>
            <column name="session_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIMESTAMPTZ"/>
            <column name="energy_consumed_kwh" type="DECIMAL(10,4)"/>
            <column name="tariff_per_kwh" type="DECIMAL(10,4)"/>
            <column name="energy_charge" type="DECIMAL(10,2)"/>
            <column name="gst_rate" type="DECIMAL(6,4)" defaultValueNumeric="0.05"/>
            <column name="gst_amount" type="DECIMAL(10,2)"/>
            <column name="service_fee" type="DECIMAL(10,2)" defaultValueNumeric="0.0"/>
            <column name="discount" type="DECIMAL(10,2)" defaultValueNumeric="0.0"/>
            <column name="total_amount" type="DECIMAL(10,2)"/>
            <column name="currency" type="VARCHAR(3)" defaultValue="INR"/>
            <column name="customer_name" type="VARCHAR(200)"/>
            <column name="customer_phone" type="VARCHAR(20)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="COMPLETED">
                <!-- COMPLETED, PAYMENT_PENDING, PAID -->
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>
        <createIndex tableName="charging_sessions" indexName="idx_sessions_session_id">
            <column name="session_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
