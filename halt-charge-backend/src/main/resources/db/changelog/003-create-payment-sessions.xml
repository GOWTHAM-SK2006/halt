<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-payment-sessions" author="haltcharge">
        <!-- payment_sessions: stores QR token → charging session mapping -->
        <createTable tableName="payment_sessions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <!-- Cryptographically random token, embedded in QR code URL -->
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="charging_session_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payment_session_charging"
                    references="charging_sessions(id)"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <!-- PENDING, PAID, EXPIRED, FAILED -->
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()"/>
        </createTable>
        <createIndex tableName="payment_sessions" indexName="idx_payment_sessions_token">
            <column name="token"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
