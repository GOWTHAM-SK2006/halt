# Docker build context exclusions for the root frontend service
# The frontend is plain static HTML/CSS/JS — no Node.js build needed.

# Exclude the backend (has its own separate Railway service & Dockerfile)
halt-charge-backend/

# Git and IDE metadata
.git/
.gitignore
.idea/
.vscode/

# Docs and build config not needed inside the image
README.md
*.md
nixpacks.toml
package.json
railway.toml
